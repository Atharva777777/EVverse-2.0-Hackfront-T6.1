# EVverse 2.0 - Standalone "Will I Make It?" Configuration

# Backend API Configuration
HOST=127.0.0.1
PORT=8000
DRIVER_DB_PATH=data/driver.db

# Open Charge Map API (Optional - automatically falls back to verified offline station database)
OPEN_CHARGE_MAP_API_KEY=

# Bureau of Energy Efficiency (BEE) EV Charging Stations API
BEE_API_BASE_URL=https://ev-charging-stations-api.vercel.app

# OpenStreetMap Overpass API
OSM_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
